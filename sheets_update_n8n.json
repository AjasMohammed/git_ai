    },
    {
      "parameters": {
        "jsCode": "const data = $input.all()[0]?.json?.content?.parts?.[0];\nconst text = data?.text ?? '';\nconst jsonString = text.replace(/```json|```/g, '').trim();\nconsole.log(jsonString);\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonString);\n} catch (e) {\n  throw new Error(\"Failed to parse JSON: \" + e.message + \" | Input: \" + jsonString);\n}\n\nif (Array.isArray(parsed)) {\n  return parsed.map(item => ({ json: item }));\n} else if (typeof parsed === \"object\" && parsed !== null) {\n  return [{ json: parsed }];\n} else {\n  throw new Error(\"Parsed JSON is not an array or object: \" + JSON.stringify(parsed));\n}"
      },
